NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GTM_ID=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL=
RESEND_API_KEY=

# Vercel Blob (attachments)
# BLOB_STORE_ID is injected automatically when the Blob store is connected to
# the project. Server-side reads (list, del, get) authenticate via OIDC in Vercel.
# BLOB_READ_WRITE_TOKEN is required for client uploads via handleUpload — create
# a Read/Write token in the Vercel dashboard and set it in every environment.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Redis rate limiter (Upstash via Vercel Marketplace)
# In Vercel: KV_REST_API_URL and KV_REST_API_TOKEN are injected automatically
# when the Redis store is connected to the project.
# UPSTASH_REDIS_REST_URL/TOKEN are accepted as a fallback for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=

ATTACHMENT_SIGNING_SECRET=
CRON_SECRET=
